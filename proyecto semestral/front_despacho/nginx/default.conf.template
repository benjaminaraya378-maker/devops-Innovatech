server {
    listen       8080;
    server_name  _;
    server_tokens off;

    root   /usr/share/nginx/html;
    index  index.html;

    # ---- Proxy reverso a los backends en la subred privada ----
    # Las URLs reales se inyectan en arranque desde GitHub Secrets
    # (BACK_VENTAS_URL y BACK_DESPACHOS_URL).
    location /api/v1/ventas {
        proxy_pass ${BACK_VENTAS_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    location /api/v1/despachos {
        proxy_pass ${BACK_DESPACHOS_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # ---- SPA fallback: cualquier ruta cae en index.html ----
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache largo para assets versionados de Vite
    location ~* \.(?:js|css|woff2?|ttf|otf|eot|svg|jpg|jpeg|png|gif|webp|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
