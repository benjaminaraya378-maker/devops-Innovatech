# =====================================================
# Innovatech Chile - Variables de entorno (template)
# =====================================================
# Copiar como .env y editar. NUNCA commitear .env real.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=cambia_esta_password_root
DB_USERNAME=innovatech
DB_PASSWORD=cambia_esta_password_app
DB_NAME_VENTAS=ventas_db
DB_NAME_DESPACHOS=despachos_db

# ---------- Frontend (Nginx) ----------
# En local Docker Compose: nombres de servicio
BACK_VENTAS_URL=http://back-ventas:8080
BACK_DESPACHOS_URL=http://back-despachos:8081
# En produccion EC2: IPs privadas
# BACK_VENTAS_URL=http://10.0.2.10:8080
# BACK_DESPACHOS_URL=http://10.0.2.11:8081
